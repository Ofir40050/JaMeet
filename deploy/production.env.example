# Server Environment Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
ALLOWED_ORIGINS=jameet-app://bundle,musiczoom-app://bundle

# TURN Provider Configuration: "cloudflare" (managed) or "self_hosted" (coturn)
TURN_PROVIDER=cloudflare
TURN_CREDENTIAL_TTL_SECONDS=3600

# ==============================================================================
# Cloudflare Realtime TURN Configuration (when TURN_PROVIDER=cloudflare)
# ==============================================================================
# Cloudflare Calls TURN Key ID from Cloudflare Dashboard (Calls -> TURN Keys)
CLOUDFLARE_TURN_KEY_ID=replace-with-cloudflare-turn-key-id
# Cloudflare API Token with Calls:Edit permissions
CLOUDFLARE_TURN_API_TOKEN=replace-with-cloudflare-api-token

# ==============================================================================
# Self-Hosted Coturn Configuration (when TURN_PROVIDER=self_hosted)
# ==============================================================================
# Required public DNS. Both A records must point directly to TURN_EXTERNAL_IP.
SIGNALING_DOMAIN=signal.yourdomain.com
TURN_HOST=turn.yourdomain.com
TURN_REALM=turn.yourdomain.com

# Required public server addressing for coturn container.
TURN_EXTERNAL_IP=203.0.113.10
# Optional: primary private/interface IPv4 on NAT-based cloud VMs (for example 10.0.0.5).
TURN_PRIVATE_IP=

# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=replace-with-64-hex-characters

TURN_PORT=3478
TURN_TLS_ENABLED=false
TURN_TLS_PORT=5349
TURN_TLS_CERT_FILE=/certs/fullchain.pem
TURN_TLS_KEY_FILE=/certs/privkey.pem
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Meeting & Session Lifecycle
DISCONNECT_GRACE_MS=30000
EMPTY_ROOM_TTL_MS=28800000
