# Server Environment Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
ALLOWED_ORIGINS=jameet-app://bundle,musiczoom-app://bundle

# TURN Provider Configuration: "cloudflare" (managed) or "self_hosted" (coturn)
TURN_PROVIDER=cloudflare
TURN_CREDENTIAL_TTL_SECONDS=28800

# ==============================================================================
# Cloudflare Realtime TURN Configuration (when TURN_PROVIDER=cloudflare)
# ==============================================================================
# Cloudflare Calls TURN Key ID from Cloudflare Dashboard (Calls -> TURN Keys)
CLOUDFLARE_TURN_KEY_ID=replace-with-cloudflare-turn-key-id
# Server-side TURN key API token used with the TURN Key ID to generate temporary ICE credentials
CLOUDFLARE_TURN_API_TOKEN=replace-with-cloudflare-api-token

# Cloudflare Account ID (from Cloudflare dashboard URL or Account Overview)
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
# Cloudflare API Token with "Account Analytics:Read" permission (for GraphQL usage query)
CLOUDFLARE_TURN_ANALYTICS_API_TOKEN=replace-with-cloudflare-analytics-api-token

# Monthly usage soft limit in GB (default: 600).
# NOTE: 600 GB is a configured application soft limit that provides a substantial
# planned buffer below Cloudflare's 1000 GB free tier. This protection reduces
# billing risk but cannot guarantee that total Cloudflare usage will remain below
# 1000 GB or that no charges will occur. Actual Cloudflare usage can continue above
# 600 GB due to analytics reporting delays, traffic already in progress, and TURN
# credentials issued before the threshold (which can remain valid for up to 8 hours).
# JaMeet does not actively revoke credentials or disconnect active calls when the limit is reached.
TURN_MONTHLY_SOFT_LIMIT_GB=600
# Usage cache check interval in seconds (default: 60 = 1 minute).
# Note: When verified usage reaches 500 GB, fresh queries are required on every credential generation.
TURN_USAGE_CHECK_INTERVAL_SECONDS=60

# ==============================================================================
# Self-Hosted Coturn Configuration (when TURN_PROVIDER=self_hosted)
# ==============================================================================
# Required public DNS. Both A records must point directly to TURN_EXTERNAL_IP.
SIGNALING_DOMAIN=signal.yourdomain.com
TURN_HOST=turn.yourdomain.com
TURN_REALM=turn.yourdomain.com

# Required public server addressing for coturn container.
TURN_EXTERNAL_IP=203.0.113.10
# Optional: primary private/interface IPv4 on NAT-based cloud VMs (for example 10.0.0.5).
TURN_PRIVATE_IP=

# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=replace-with-64-hex-characters

TURN_PORT=3478
TURN_TLS_ENABLED=false
TURN_TLS_PORT=5349
TURN_TLS_CERT_FILE=/certs/fullchain.pem
TURN_TLS_KEY_FILE=/certs/privkey.pem
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Meeting & Session Lifecycle
DISCONNECT_GRACE_MS=30000
EMPTY_ROOM_TTL_MS=28800000
