{
  "name": "@jameet/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Two-person remote music sessions",
  "author": "JaMeet",
  "desktopName": "JaMeet",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:2": "node scripts/dev-instance.cjs 2",
    "dev:instance": "node scripts/dev-instance.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build": "npm run build:native && electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package:mac": "npm run build && node scripts/build-macos-pkg.cjs",
    "package:mac:release": "npm run build && node scripts/build-macos-pkg.cjs",
    "package:mac:pkg": "npm run build && node scripts/build-macos-pkg.cjs",
    "package:mac:preview": "npm run build && node scripts/build-macos-pkg.cjs --preview",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:win:x64": "npm run build && electron-builder --win --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@jameet/shared": "0.1.0",
    "lucide": "^1.31.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.jameet.app",
    "productName": "JaMeet",
    "executableName": "JaMeet",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "JaMeet Session",
        "schemes": [
          "jameet",
          "musiczoom"
        ]
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "!**/*.driver",
            "!**/*.driver/**"
          ]
        }
      ],
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSCameraUsageDescription": "JaMeet uses your camera for remote music sessions.",
        "NSMicrophoneUsageDescription": "JaMeet uses your microphone or audio interface for remote music sessions."
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "**/*.exe"
          ]
        },
        {
          "from": "src/main/driver-windows/package",
          "to": "driver-windows/package",
          "filter": [
            "*"
          ]
        },
        {
          "from": "src/main/driver-windows",
          "to": "driver-windows",
          "filter": [
            "*.inf",
            "*.cat",
            "*.sys",
            "*.cmd",
            "dist/**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JaMeet",
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "syncDesktopName": true
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "JaMeet-${version}-${os}-${arch}.${ext}"
  }
}
