[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = JaMeetRemote.cat
DriverVer   = 08/15/2026,1.0.0.0
PnpLockDown = 1

[DestinationDirs]
DefaultDestDir = 13 ; Driver Store

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
JaMeetRemote.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%JaMeetRemote.DeviceDesc% = JaMeetRemote_Device, ROOT\JaMeetRemote

[Standard.NTarm64.10.0]
%JaMeetRemote.DeviceDesc% = JaMeetRemote_Device, ROOT\JaMeetRemote

[JaMeetRemote_Device.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration, PnPGeneric.Registration
CopyFiles = JaMeetRemote_Device.NT.CopyFiles
AddReg    = JaMeetRemote_Device.NT.AddReg

[JaMeetRemote_Device.NT.CopyFiles]
JaMeetRemote.sys

[JaMeetRemote_Device.NT.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,JaMeetRemote.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%JaMeetRemote.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%JaMeetRemote.DeviceDesc%

[JaMeetRemote_Device.NT.HW]
AddReg = JaMeetRemote_Device.NT.HW.AddReg

[JaMeetRemote_Device.NT.HW.AddReg]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[JaMeetRemote_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Wave%, JaMeetRemote.Interface.Wave
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_Wave%, JaMeetRemote.Interface.Wave
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_Wave%, JaMeetRemote.Interface.Wave
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Wave%, JaMeetRemote.Interface.Wave
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_Topo%, JaMeetRemote.Interface.Topo

[JaMeetRemote.Interface.Wave]
AddReg = JaMeetRemote.Interface.Wave.AddReg

[JaMeetRemote.Interface.Wave.AddReg]
HKR,,FriendlyName,,%JaMeetRemote.Wave.szPname%
HKR,,CLSID,,%Proxy.CLSID%

[JaMeetRemote.Interface.Topo]
AddReg = JaMeetRemote.Interface.Topo.AddReg

[JaMeetRemote.Interface.Topo.AddReg]
HKR,,FriendlyName,,%JaMeetRemote.Topo.szPname%
HKR,,CLSID,,%Proxy.CLSID%

[JaMeetRemote_Device.NT.Services]
AddService = JaMeetRemote, 0x00000002, JaMeetRemote_Service_Install, JaMeetRemote_Logging_Install

[JaMeetRemote_Service_Install]
DisplayName    = %JaMeetRemote.DeviceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\JaMeetRemote.sys

[JaMeetRemote_Logging_Install]

[Strings]
ManufacturerName          = "JaMeet"
DiskName                  = "JaMeet Remote Installation Disk"
JaMeetRemote.DeviceDesc   = "JaMeet Remote"
JaMeetRemote.Wave.szPname = "JaMeet Remote Audio"
JaMeetRemote.Topo.szPname = "JaMeet Remote Topology"

KSNAME_Wave               = "Wave"
KSNAME_Topo               = "Topology"

Proxy.CLSID               = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO          = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE        = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_RENDER         = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME       = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY       = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
