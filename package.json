{
  "name": "jameet",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @jameet/shared && npm run build -w @jameet/server && npm run build -w @jameet/desktop",
    "build:server": "npm run build -w @jameet/shared && npm run build -w @jameet/server",
    "start": "node apps/server/dist/index.js",
    "start:server": "node apps/server/dist/index.js",
    "admin:access": "npm run admin:access -w @jameet/server --",
    "dev:server": "npm run build -w @jameet/shared && npm run dev -w @jameet/server",
    "dev:desktop": "npm run build -w @jameet/shared && npm run dev -w @jameet/desktop",
    "dev:desktop:2": "node apps/desktop/scripts/dev-instance.cjs 2",
    "dev:desktop:peer": "node apps/desktop/scripts/dev-instance.cjs 2",
    "test": "npm run build -w @jameet/shared && npm test --workspaces --if-present",
    "typecheck": "npm run build -w @jameet/shared && npm run typecheck --workspaces --if-present",
    "package:mac": "sh deploy/build-production-mac.sh",
    "package:mac:production": "sh deploy/build-production-mac.sh",
    "package:mac:release": "sh deploy/build-production-mac.sh",
    "package:mac:preview": "sh deploy/build-preview-mac.sh",
    "package:win": "npm run package:win -w @jameet/desktop",
    "package:win:production": "node deploy/build-production-win.cjs",
    "package:linux": "npm run package:linux -w @jameet/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
