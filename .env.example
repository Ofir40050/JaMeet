NODE_ENV=production
HOST=0.0.0.0
PORT=3000
ALLOWED_ORIGINS=musiczoom-app://bundle
SIGNALING_DOMAIN=signal.example.com
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_TLS_ENABLED=false
TURN_TLS_CERT_FILE=/certs/fullchain.pem
TURN_TLS_KEY_FILE=/certs/privkey.pem
TURN_REALM=turn.example.com
TURN_SHARED_SECRET=replace-with-at-least-32-random-characters
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_EXTERNAL_IP=203.0.113.10
# Set this to the server's primary private/interface IPv4 when the cloud provider
# maps a public address onto a private NIC. Leave blank if the public IP is bound directly.
TURN_PRIVATE_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
DISCONNECT_GRACE_MS=30000
EMPTY_ROOM_TTL_MS=28800000
